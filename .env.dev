# Database - Docker Compose
DATABASE_PORT=7133
DATABASE_NAME=ConsiliumTempus
DATABASE_USER=SA
DATABASE_PASSWORD=StrongPassword123

# Api
# Host port of the api (used in Docker Compose and for e2e testing)
API_PORT=7123

# Frontend
# Origin that is allowed by the CORS policy (the one of the frontend, used in the production Docker Compose)
FRONTEND_ORIGIN=http://localhost:8123

# Sample Data
# Inserts the sample data when the migrator runs (only enable it in development)
SAMPLE_DATA_ENABLED=true
