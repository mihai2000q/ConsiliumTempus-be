# Database - Docker Compose
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Api
# Host port of the api (used in Docker Compose and for e2e testing)
API_PORT=

# Dotnet user-secrets folder mounted by docker-compose.yml (optional)
# Defaults to %APPDATA%/Microsoft/UserSecrets (Windows); on Linux/macOS use ~/.microsoft/usersecrets
# USER_SECRETS_PATH=/home/<user>/.microsoft/usersecrets
